# Staging Credentials (Saved for future use)
STAGING_AUTH_TOKEN=
STAGING_USER_ID=
STAGING_EMAIL=
STAGING_COMPANY_ID=

# Local Credentials (Real Seeded User)
LOCAL_AUTH_TOKEN=
LOCAL_USER_ID=
LOCAL_EMAIL=
LOCAL_PASSWORD=
LOCAL_COMPANY_ID=

# Bypass Control
# Options: 'local' or 'staging'
BYPASS_AUTH_MODE=local

# API URL Configuration
# Local development (use your machine's IP for physical devices)
#API_URL=http://192.168.1.54:5001
# Staging
API_URL=https://staging-api.silkroadapp.com

# Google Maps
GOOGLE_MAPS_API_KEY=

# AWS Configuration (Textract for receipt processing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# RevenueCat (In-App Purchases / Subscriptions)
REVENUECAT_API_KEY=

# OneSignal Push Notifications
ONESIGNAL_APP_ID=

# Barcode Lookup API (Go-UPC)
BARCODE_API_KEY=
BARCODE_API_PROVIDER=go-upc
